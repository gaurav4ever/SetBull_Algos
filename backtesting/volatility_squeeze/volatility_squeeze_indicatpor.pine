    map.put(threshold_map, "JINDALSAW", 0.57)
    map.put(threshold_map, "IIFLCAPS", 1.14)
    map.put(threshold_map, "INDSWFTLAB", 0.20)
    map.put(threshold_map, "DCXINDIA", 0.63)
    map.put(threshold_map, "ECOSMOBLTY", 1.41)
    map.put(threshold_map, "QUESS", 0.65)
    map.put(threshold_map, "YATRA", 0.30)
    map.put(threshold_map, "SHARDACROP", 2.67)
    map.put(threshold_map, "KHAICHEM", 0.19)
    map.put(threshold_map, "CCL", 1.74)
    map.put(threshold_map, "SMCGLOBAL", 0.60)
    map.put(threshold_map, "KPEL", 2.22)
    map.put(threshold_map, "RELTD", 0.90)
    map.put(threshold_map, "KPIGREEN", 2.29)
    map.put(threshold_map, "PFOCUS", 0.13)
    map.put(threshold_map, "ORCHPHARMA", 1.61)
    map.put(threshold_map, "MTNL", 0.18)
    map.put(threshold_map, "HUBTOWN", 0.59)
    map.put(threshold_map, "MARATHON", 2.79)

// Get threshold for current symbol
map_threshold = map.get(threshold_map, syminfo.ticker)
final_threshold = use_map_thresholds and not na(map_threshold) ? map_threshold : user_threshold

// Threshold source tracking
threshold_source = use_map_thresholds and not na(map_threshold) ? "Map" : "Manual"

// ========================================
// BB Width Calculation
// ========================================

// Calculate Bollinger Bands
bb_middle = ta.sma(close, bb_period)
bb_std = ta.stdev(close, bb_period)
bb_upper = bb_middle + (bb_std_dev * bb_std)
bb_lower = bb_middle - (bb_std_dev * bb_std)

// Calculate normalized BB Width percentage
bb_width = (bb_upper - bb_lower)

// 20% of bb_width
bb_width -= bb_width*0.7

// ========================================
// Squeeze Detection Logic
// ========================================

// Check if current BB width is below threshold
squeeze_condition = bb_width <= final_threshold

// Log BB width for debugging - log all visible bars
if barstate.isconfirmed
    log.info("Time: " + str.tostring(time) + " | BB Width: " + str.tostring(bb_width, "#.####") + " | Upper: " + str.tostring(bb_upper, "#.####") + " | Lower: " + str.tostring(bb_lower, "#.####") + " | Middle: " + str.tostring(bb_middle, "#.####") + " | Threshold: " + str.tostring(final_threshold, "#.####") + " | Squeeze: " + (squeeze_condition ? "YES" : "NO"))

// ========================================
// PHASE 3: Advanced Visual System
// ========================================

// Squeeze intensity calculation
squeeze_intensity = final_threshold / bb_width

// Enhanced triangle position logic
triangle_position = close > bb_middle ? high : low

// Color gradient based on squeeze intensity
triangle_color = squeeze_intensity > 1.5 ? color.red : 
                 squeeze_intensity > 1.2 ? color.orange : 
                 squeeze_intensity > 1.1 ? color.yellow : color.green

// Triangle size based on squeeze intensity
triangle_size = squeeze_intensity > 1.5 ? size.large : squeeze_intensity > 1.2 ? size.normal : size.small

// Enhanced visual alert with intensity-based styling
plotshape(squeeze_condition and show_squeeze_alerts, "Squeeze Alert Up", shape.triangleup, location.belowbar, triangle_color, size=size.tiny)

// ========================================
// PHASE 4: Advanced Features & Optimization
// ========================================

// User customization inputs
show_info_table = input.bool(true, "Show Information Table", group="User Customization")
show_labels = input.bool(false, "Show Detailed Labels", group="User Customization")
alert_on_squeeze = input.bool(false, "Alert on Squeeze", group="Alert System")
alert_on_intensity = input.float(1.5, "Alert on Intensity >", minval=1.0, maxval=3.0, group="Alert System")

// Intensity-based alert conditions
extreme_squeeze = squeeze_intensity > 1.5
strong_squeeze = squeeze_intensity > 1.2
moderate_squeeze = squeeze_intensity > 1.1

// Alert system with intensity filtering
if alert_on_squeeze and squeeze_condition and squeeze_intensity >= alert_on_intensity
    alert("🚨 Volatility Squeeze Alert: " + syminfo.ticker + 
          "\nBB Width: " + str.tostring(bb_width, "#.##") + "%" +
          "\nThreshold: " + str.tostring(final_threshold, "#.##") + "%" +
          "\nIntensity: " + str.tostring(squeeze_intensity, "#.##") +
          "\nDirection: " + (close > bb_middle ? "Bullish" : "Bearish"), 
          alert.freq_once_per_bar)

// Detailed labels for squeeze analysis
if show_labels and squeeze_condition
    label_text = "SQ: " + str.tostring(bb_width, "#.##") + "%\n" +
                 "Int: " + str.tostring(squeeze_intensity, "#.##") + "\n" +
                 "Dir: " + (close > bb_middle ? "↑" : "↓")
    
    label.new(bar_index, triangle_position, label_text,
              style=label.style_label_down,
              color=triangle_color,
              textcolor=color.white,
              size=size.small)

// ========================================
// Visual Rendering
// ========================================

// Plot Bollinger Bands (always calculate, conditionally display)
plot(show_bb_bands ? bb_upper : na, "BB Upper", color=color.blue, linewidth=1)
plot(show_bb_bands ? bb_middle : na, "BB Middle", color=color.gray, linewidth=1)
plot(show_bb_bands ? bb_lower : na, "BB Lower", color=color.blue, linewidth=1)

// ========================================
// Performance Optimization
// ========================================

// Prevent repainting by using confirmed bars only
bb_width := barstate.isconfirmed ? bb_width : bb_width[1]
squeeze_condition := barstate.isconfirmed ? squeeze_condition : squeeze_condition[1]
squeeze_intensity := barstate.isconfirmed ? squeeze_intensity : squeeze_intensity[1]

// Cache frequently used calculations
bb_middle := barstate.isconfirmed ? bb_middle : bb_middle[1]
bb_upper := barstate.isconfirmed ? bb_upper : bb_upper[1]
bb_lower := barstate.isconfirmed ? bb_lower : bb_lower[1]
